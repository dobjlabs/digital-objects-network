# Keep the build context small and free of secrets.

# The frontend is not needed to build the chain-side services.
interfaces/gui/**

# The workspace shares one target/ at the root.
target
**/target
**/node_modules

# Secrets and local state - never bake these into an image.
.env
**/.env
data
logs
*.log

# VCS and tooling.
.git
.github
.claude

# Release tarballs and OS cruft.
*.tar.gz
.DS_Store
