{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bitcraft",
  "version": "0.1.0",
  "identifier": "app.bitcraft.desktop",
  "build": {
    "frontendDist": "../shell"
  },
  "plugins": {
    "updater": { "endpoints": [], "pubkey": "" }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [{
        "identifier": "inventory-metrics",
        "description": "Read native inventory value and production rate",
        "windows": ["main"],
        "local": false,
        "remote": { "urls": ["http://127.0.0.1:7727/bitcraft/*"] },
        "permissions": ["allow-inventory-metrics"]
      }],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "category": "Game",
    "shortDescription": "Bitcraft with its managed Digital Objects runtime",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
