/*
  txlib: Transaction predicates for verifiable state transitions.

  See README.md for the conceptual overview (what a transaction is,
  what actions and classes are, how replay validates state changes).
  The chain primitives (TxInsert/TxMutate/TxDelete) live in the
  imported tx_events module so their hashes survive churn in this
  file. This file is the rest, organized in three layers, bottom-up:

  1. Replay -- walks the recorded chain, verifying each event's
     hash step, updating the created/nullifier sets, and calling the
     affected object's type guard to authorize the event.

  2. InputsGroundedAndSpent -- proves each input object is present in
     the global created set and nullified by this transaction.

  3. TxFinalized -- the public entry point. Ties input grounding,
     chain seeding, and full replay together. Exposes
     (state_header, tx_final, nullifiers, created) publicly.

  State convention: most predicates thread four public arguments:
  (before_tx, after_tx, before_chain, after_chain). Each step
  transforms (before_tx, before_chain) into (after_tx, after_chain).
  Steps compose by chaining: one step's "after" is the next step's
  "before".

  Tx = {
    inputs: set,          // immutable grounded inputs
    created: set,         // all states produced so far
    nullifiers: set,      // accumulated nullifiers (double-spend prevention)
    chain_start: hash,    // enclosing action's chain start (for guard dispatch)
    chain_end: hash       // enclosing action's chain end (for guard dispatch)
  }
*/

use module 0xTX_EVENTS_MODULE_HASH as tx

// ========================================================
// Replay: Helpers
// ========================================================

// Standalone nullifier derivation: H(H(obj, obj.key), "txlib-nullifier-v1").
// In practice we inline this into ReplayNullify, but it's useful to have it
// for third-party code that needs to compute nullifiers outside of replay.
Nullify(nullifier, obj, private: obj_key_hash) = AND(
  Hash(obj, obj.key, obj_key_hash)
  Hash(obj_key_hash, "txlib-nullifier-v1", nullifier)
)

// ========================================================
// Replay: List Structure
// ========================================================
//
// The body of an action is a list of events (inserts, mutates,
// deletes, sub-actions). ReplayContents is the predicate that walks
// this list and applies each event's state change and guard dispatch
// (see README.md for the conceptual pseudocode).
//
// Conceptually this is a for-loop, but in podlang it must be expressed
// as a recursive OR: at each step the list is either a single trailing
// event (the K=1 leaf, ReplayElement) or one head event followed by a
// recursive ReplayContents call for the tail. Empty bodies are
// forbidden by TxBuilder, so there's no K=0 leaf.
//
// A naive Step predicate would OR over all four event types inside
// every recursion step. Instead, because the prover knows the head
// event's type, it picks one of four specialised variants:
//   StepInsert  -- head=Insert, tail=ReplayContents (K-1 elements)
//   StepMutate  -- head=Mutate, tail=ReplayContents (K-1 elements)
//   StepDelete  -- head=Delete, tail=ReplayContents (K-1 elements)
//   StepAction  -- head=Action, tail=ReplayContents (K-1 elements)
// Each variant fixes the head event's type at podlang level, folding
// out the per-iteration OR-dispatch that ReplayElement still needs at
// the trailing leaf.

ReplayContents(state_header, before_tx, after_tx, before_chain, after_chain) = OR(
  ReplayElement(state_header, before_tx, after_tx, before_chain, after_chain)
  ReplayContentsStepInsert(state_header, before_tx, after_tx, before_chain, after_chain)
  ReplayContentsStepMutate(state_header, before_tx, after_tx, before_chain, after_chain)
  ReplayContentsStepDelete(state_header, before_tx, after_tx, before_chain, after_chain)
  ReplayContentsStepAction(state_header, before_tx, after_tx, before_chain, after_chain)
)

// The four specialised step variants.
ReplayContentsStepInsert(state_header, before_tx, after_tx, before_chain, after_chain,
    private: mid_tx, mid_chain) = AND(
  ReplayInsert(state_header, before_tx, mid_tx, before_chain, mid_chain)
  ReplayContents(state_header, mid_tx, after_tx, mid_chain, after_chain)
)

ReplayContentsStepMutate(state_header, before_tx, after_tx, before_chain, after_chain,
    private: mid_tx, mid_chain) = AND(
  ReplayMutate(state_header, before_tx, mid_tx, before_chain, mid_chain)
  ReplayContents(state_header, mid_tx, after_tx, mid_chain, after_chain)
)

ReplayContentsStepDelete(state_header, before_tx, after_tx, before_chain, after_chain,
    private: mid_tx, mid_chain) = AND(
  ReplayDelete(state_header, before_tx, mid_tx, before_chain, mid_chain)
  ReplayContents(state_header, mid_tx, after_tx, mid_chain, after_chain)
)

ReplayContentsStepAction(state_header, before_tx, after_tx, before_chain, after_chain,
    private: mid_tx, mid_chain) = AND(
  ReplayAction(state_header, before_tx, mid_tx, before_chain, mid_chain)
  ReplayContents(state_header, mid_tx, after_tx, mid_chain, after_chain)
)

// A single element: one of the three event types, or a nested
// action (which recursively contains its own ReplayContents).
ReplayElement(state_header, before_tx, after_tx, before_chain, after_chain) = OR(
  ReplayInsert(state_header, before_tx, after_tx, before_chain, after_chain)
  ReplayMutate(state_header, before_tx, after_tx, before_chain, after_chain)
  ReplayDelete(state_header, before_tx, after_tx, before_chain, after_chain)
  ReplayAction(state_header, before_tx, after_tx, before_chain, after_chain)
)

// ========================================================
// Replay: Actions
// ========================================================
//
// An action is a contiguous segment of the hash chain that groups
// related events (e.g. "mine a stone" = mutate pick + insert stone).
// Actions nest: a parent action can contain sub-actions.
//
// Replaying an action:
//   1. Write the action's chain range into tx as chain_start/chain_end
//      (so guard dispatch knows which action scope to match).
//   2. Replay the action's contents (events and sub-actions).
//   3. Copy inner created/nullifier changes back to the outer tx
//      (restoring the parent's chain_start/chain_end automatically,
//      since after_tx derives from before_tx, not inner_tx).

// Set chain_start/chain_end in tx, replay contents, copy created/nullifiers
// back to outer tx (which restores the parent's chain_start/chain_end).
ReplayAction(state_header, before_tx, after_tx, before_chain, after_chain,
    private: pair, inner_tx, end_tx) = AND(
  DictUpdate(before_tx, "chain_start", before_chain, pair.scope_mid)
  DictUpdate(pair.scope_mid, "chain_end", after_chain, inner_tx)
  ReplayContents(state_header, inner_tx, end_tx, before_chain, after_chain)
  DictUpdate(before_tx, "created", end_tx.created, pair.mid)
  DictUpdate(pair.mid, "nullifiers", end_tx.nullifiers, after_tx)
)

// Top-level walker: every event at the transaction's top level is
// required by construction to be an action (the prover API never
// emits bare events outside an action scope). Dispatching directly
// to ReplayAction here skips the ReplayElement layer that would
// otherwise be needed to discriminate between event variants.
// ReplayContents is still used *within* an action, where inserts,
// mutates, deletes, and sub-actions can all appear. Empty top-level
// transactions are forbidden by TxBuilder, so there is no Done leaf.
//
// `ReplayActionInsert` is a K=1 fast path: when the single top-level
// action's body is a lone Insert, the entire transaction proves in
// 2 statements from this OR (ReplayActions -> ReplayActionInsert),
// bypassing ReplayAction/ReplayContents/ReplayElement/ReplayInsert
// (5 statements). "Mining" actions that just produce one object hit
// this path.
ReplayActions(state_header, before_tx, after_tx, before_chain, after_chain) = OR(
  ReplayAction(state_header, before_tx, after_tx, before_chain, after_chain)
  ReplayActionsStep(state_header, before_tx, after_tx, before_chain, after_chain)
  ReplayActionInsert(state_header, before_tx, after_tx, before_chain, after_chain)
)

// One action, then a recursive tail. Used for transactions that
// contain 2+ top-level actions.
ReplayActionsStep(state_header, before_tx, after_tx, before_chain, after_chain,
    private: mid_tx, mid_chain) = AND(
  ReplayAction(state_header, before_tx, mid_tx, before_chain, mid_chain)
  ReplayActions(state_header, mid_tx, after_tx, mid_chain, after_chain)
)

// K=1 fast path: a single-event action whose only event is an Insert.
// Same body as ReplayInsert, but the guard's chain bounds come from
// the predicate's public args (`before_chain`/`after_chain`) instead
// of `before_tx.chain_start`/`before_tx.chain_end`. Because the
// action spans the whole chain range, the public args ARE the action's
// chain scope, so the guard sees the same values it would have seen
// inside a `ReplayAction`-materialized `inner_tx`. Skipping that
// materialization is what saves the three intermediate statements.
ReplayActionInsert(state_header, before_tx, after_tx, before_chain, after_chain,
    private: new, pair, guard) = AND(
  tx::TxInsert(before_chain, after_chain, pair.initial, new, guard)
  SetInsert(before_tx.created, new, pair.new_created)
  DictUpdate(before_tx, "created", pair.new_created, after_tx)
  guard(new, state_header, before_chain, after_chain)
)

// ========================================================
// Replay: Insert
// ========================================================

// Full insert replay: chain step (via TxInsert) + created update +
// guard dispatch. Referencing TxInsert instead of re-proving the
// Hash equations lets the prover reuse the record-time statement
// that it already built for the application's action predicate.
// To stay within pod2's 8-wildcard limit, some private wildcards are packed
// into a small private dict and accessed via anchored keys:
// `pair.initial`/`pair.new_created` for Insert, `pair.source_key`/`pair.source`
// for Delete.
ReplayInsert(state_header, before_tx, after_tx, before_chain, after_chain,
    private: new, pair, guard) = AND(
  tx::TxInsert(before_chain, after_chain, pair.initial, new, guard)
  SetInsert(before_tx.created, new, pair.new_created)
  DictUpdate(before_tx, "created", pair.new_created, after_tx)
  guard(new, state_header, before_tx.chain_start, before_tx.chain_end)
)

// ========================================================
// Replay: Mutate
// ========================================================

// Nullifier computation and accumulation. Shared by mutate and
// delete to prevent double-spending of the consumed object.
// nullifier = H(H(obj, obj.key), "txlib-nullifier-v1")
ReplayNullify(mid_tx, after_tx, old, source,
    private: obj_key_hash, nullifier, new_nullifiers) = AND(
  SetContains(source, old)
  Hash(old, old.key, obj_key_hash)
  Hash(obj_key_hash, "txlib-nullifier-v1", nullifier)
  SetInsert(mid_tx.nullifiers, nullifier, new_nullifiers)
  DictUpdate(mid_tx, "nullifiers", new_nullifiers, after_tx)
)

// The source is selected from the pre-mutation context: an output cannot
// establish its own input's existence. ReplayNullify checks membership and
// rejects a second consumption by requiring a fresh nullifier.
ReplayMutateEvent(before_tx, after_tx, old, new,
    private: new_created, mid_tx, source_key, source) = AND(
  SetContains(#["inputs", "created"], source_key)
  DictContains(before_tx, source_key, source)
  SetInsert(before_tx.created, new, new_created)
  DictUpdate(before_tx, "created", new_created, mid_tx)
  ReplayNullify(mid_tx, after_tx, old, source)
)

// Full mutate replay: chain step (via TxMutate) + state update +
// guard dispatch. The guard dispatches on `new` alone because
// TxMutate's shared `type` arg already pins old.type == new.type.
ReplayMutate(state_header, before_tx, after_tx, before_chain, after_chain,
    private: old, new, guard) = AND(
  tx::TxMutate(before_chain, after_chain, old, new, guard)
  ReplayMutateEvent(before_tx, after_tx, old, new)
  guard(new, state_header, before_tx.chain_start, before_tx.chain_end)
)

// ========================================================
// Replay: Delete
// ========================================================

// Full delete replay: chain step, input availability, nullification, and guard.
ReplayDelete(state_header, before_tx, after_tx, before_chain, after_chain,
    private: old, guard, pair) = AND(
  tx::TxDelete(before_chain, after_chain, old, guard)
  SetContains(#["inputs", "created"], pair.source_key)
  DictContains(before_tx, pair.source_key, pair.source)
  ReplayNullify(before_tx, after_tx, old, pair.source)
  guard(old, state_header, before_tx.chain_start, before_tx.chain_end)
)

// ========================================================
// Inputs Grounded And Spent
// ========================================================
//
// Each input must exist in the historical created array and have its
// nullifier in this transaction's final set, even if the grounding root is stale.

record StateHeader = (block_number, block_timestamp, block_hash, created, nullifiers, prior_state_history)

// The two hashes also appear in ReplayNullify and can reuse its statements.
// Including the set extension fills all five clauses of this helper.
InputGroundedAndSpent(prev, inputs, created, nullifiers, private: input, index, key_hash, nullifier) = AND(
  ArrayContains(created, index, input)
  SetInsert(prev, input, inputs)
  Hash(input, input.key, key_hash)
  Hash(key_hash, "txlib-nullifier-v1", nullifier)
  SetContains(nullifiers, nullifier)
)
InputsGroundedAndSpent(inputs, created, nullifiers) = OR(
  Equal(inputs, {})
  InputGroundedAndSpent({}, inputs, created, nullifiers)
  InputsGroundedAndSpentPair(inputs, created, nullifiers)
  InputsGroundedAndSpentTriple(inputs, created, nullifiers)
  InputsGroundedAndSpentRecursive(inputs, created, nullifiers)
)
InputsGroundedAndSpentPair(inputs, created, nullifiers, private: mid) = AND(
  InputGroundedAndSpent({}, mid, created, nullifiers)
  InputGroundedAndSpent(mid, inputs, created, nullifiers)
)
InputsGroundedAndSpentTriple(inputs, created, nullifiers, private: mid1, mid2) = AND(
  InputGroundedAndSpent({}, mid1, created, nullifiers)
  InputGroundedAndSpent(mid1, mid2, created, nullifiers)
  InputGroundedAndSpent(mid2, inputs, created, nullifiers)
)
// Four helpers leave one clause for recursion. Counts divisible by four
// terminate at the empty branch; other counts use the single/pair/triple leaf.
InputsGroundedAndSpentRecursive(inputs, created, nullifiers, private: prev, mid1, mid2, mid3) = AND(
  InputGroundedAndSpent(prev, mid1, created, nullifiers)
  InputGroundedAndSpent(mid1, mid2, created, nullifiers)
  InputGroundedAndSpent(mid2, mid3, created, nullifiers)
  InputGroundedAndSpent(mid3, inputs, created, nullifiers)
  InputsGroundedAndSpent(prev, created, nullifiers)
)

// ========================================================
// TxFinalized
// ========================================================
//
// The public entry point. A proof of TxFinalized is a self-contained
// certificate: it attests to the final state without revealing the
// event sequence that produced it.

// Exposes (state_header, tx_final, nullifiers, created) publicly. The
// verifier sees `state_header` as a single hash -- the commitment of the
// `StateHeader` record.
// tx_final commits to the final dictionary with private inputs removed.
// It binds only created, nullifiers, and the zeroed scope fields. Both
// the nullifier set and the final created set are also surfaced as their
// own public args (via TxFinalBindings) so the synchronizer can fold
// them into its global nullifier and created sets; the chain stays
// private. The top-level walker is ReplayActions, so every top-level
// event is guaranteed to be an action (no bare events can escape an
// action's guard dispatch).
//
// The DictInsert clause pins the full schema of `before_tx`:
// `nullifiers = {}` prevents a tx from inheriting nullifiers it did
// not emit itself, and `chain_start = chain_end = {}` removes the
// malleability that would otherwise let the prover witness arbitrary
// values for those two fields (they pass through ReplayActions
// verbatim into `tx_final`, since ReplayAction only updates the
// `created` and `nullifiers` keys).
TxFinalBindings(after_tx, tx_final, nullifiers, created) = AND(
  DictDelete(after_tx, "inputs", tx_final)
  DictContains(tx_final, "nullifiers", nullifiers)
  DictContains(tx_final, "created", created)
)

TxFinalized(state_header StateHeader, tx_final, nullifiers, created,
     private: before_tx, after_tx, chain_start, chain_final) = AND(
  InputsGroundedAndSpent(before_tx.inputs, state_header.created, nullifiers)
  Hash(before_tx.inputs, {}, chain_start)
  DictInsert({"created": {}, "nullifiers": {}, "chain_start": {}, "chain_end": {}}, "inputs", before_tx.inputs, before_tx)
  TxFinalBindings(after_tx, tx_final, nullifiers, created)
  ReplayActions(state_header, before_tx, after_tx, chain_start, chain_final)
)
